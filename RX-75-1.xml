<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="RX-75-1">
  <material name="Blue">
    <color rgba="0 0 0.8 1"/>
  </material>
  <material name="Red">
    <color rgba="0.8 0 0 1"/>
  </material>
  <material name="Gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="Black">
    <color rgba="0 0 0 1"/>
  </material>

  <xacro:property name="Sprockets" value="package://my_truck_description/meshes/wheel.stl" />

  <xacro:macro name="bigwheels" params="prefix x y z">
    <link name="${prefix}_wheel_link">
      <visual>
        <geometry>
          <mesh filename="C:\Users\Kentarou\Documents\Engineering Studies\Engineering Design\RX-75-1\HullAssemblySTLs\LeftRowWheels\HullAssembly-AssemblyPad024(BigWheel1).stl" />
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${wheel_mesh}" />
        </geometry>
      </collision>
      <!-- Inertial properties would go here -->
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="chassis_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="smallwheels" params="prefix x y z">
    <link name="smallwheel_link">
      <visual>
        <geometry>
          <mesh filename=r"C:\Users\Kentarou\Documents\Engineering Studies\Engineering Design\RX-75-1\HullAssemblySTLs\LeftRowWheels\HullAssembly-AssemblyPad025(SmallWheel1).stl" />
        </geometry>
      </visual>
      <!-- Inertial properties would go here -->
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="Hull_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

